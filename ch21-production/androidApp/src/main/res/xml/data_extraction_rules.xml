<?xml version="1.0" encoding="utf-8"?>
<!-- ch21-production/androidApp/src/main/res/xml/data_extraction_rules.xml -->
<!-- Android 12+: the ciphertext is useless without its Keystore key, which
     never leaves this device, so keep it out of backups and transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="hearthseed.secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="hearthseed.secure.xml" />
    </device-transfer>
</data-extraction-rules>
