<?xml version="1.0" encoding="utf-8"?>
<!-- ch21-production/androidApp/src/main/res/xml/network_security_config.xml -->
<!-- Release and every other build type: HTTPS only, system CAs only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
