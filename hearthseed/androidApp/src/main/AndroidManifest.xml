<?xml version="1.0" encoding="utf-8"?>
<!-- hearthseed/androidApp/src/main/AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Install-time: granted without asking. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime on Android 13+: asked for on "Remind me". -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="hearthseed.android.HearthseedApplication"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name="hearthseed.android.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
